# Copie para .env antes de usar Docker ou executar localmente.
# Modo offline com dados sintéticos (ideal para demonstração).
VTS_DEMO=0

# "sqlite" (Docker/local) ou "memory" (Vercel / serverless)
VTS_CACHE_BACKEND=sqlite
VTS_DB_PATH=data/variantscope.sqlite3
VTS_CACHE_TTL=21600

# Segredos — TROQUE EM PRODUÇÃO
VTS_JWT_SECRET=dev-only-change-me-rotate-this-in-production
VTS_ADMIN_PASSWORD=admin

# Limite de requisições por IP em /api/brief
VTS_RATE_LIMIT=20
VTS_RATE_WINDOW=60

# Origens permitidas no CORS (separadas por vírgula; vazio = desabilitado)
VTS_CORS_ORIGINS=

# Opcional: aumenta o limite da API NCBI E-utilities
NCBI_API_KEY=
NCBI_EMAIL=

# Porta publicada pelo docker compose
VTS_PORT=8000
